/*
  Cache control for the static Cloudflare Pages deployment.
*/
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=3600

/script.js
  Cache-Control: public, max-age=3600

/*
  Security headers compatible with the Mapbox browser integration.
*/
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://api.mapbox.com; connect-src 'self' https://api.mapbox.com;
*/
